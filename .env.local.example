# ========================================
# Supabase PostgreSQL
# ========================================
# URL do projeto Supabase (pública, pode conter em .env.local)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Service Role Key (SECRETO - nunca commitar .env.local real!)
# Encontrar em: Supabase Dashboard > Project Settings > API > Service Role Secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ========================================
# Google OAuth (Login)
# ========================================
# Restrito a contas @mv.com.br
ALLOWED_LOGIN_DOMAINS=mv.com.br

# Credenciais OAuth do Google Cloud Console
# Encontrar em: Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret

# Base URL (localhost em dev, production em prod)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Secret para assinar sessions (gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=sua-secret-aleatoria-de-32-bytes

# ========================================
# Email (Nodemailer + Gmail)
# ========================================
# Habilitar envio de emails (true/false)
ENABLE_EMAIL=false

# Gmail de origem (usar conta de serviço)
GMAIL_USER=seu-email@mv.com.br

# Senha de app do Gmail (não é senha normal!)
# Gerar em: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=sua-senha-de-app

# Emails que recebem notificações administrativas (separados por vírgula)
ADMINISTRATIVO_EMAILS=admin1@mv.com.br,admin2@mv.com.br

# URL da aplicação (para links em emails)
APP_URL=http://localhost:3000

# ========================================
# Google Chat (Webhooks)
# ========================================
# URL do webhook para notificações de novas solicitações
# Encontrar em: Google Chat > Espaço > Gerenciar apps/integrações > Criar webhook
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/...

# URL do webhook para alertas de fila (jobs/solicitações paradas 24h+)
# Usar mesmo espaço ou espaço diferente, conforme preferir
GOOGLE_CHAT_WEBHOOK_FILA_URL=https://chat.googleapis.com/v1/spaces/...

# ========================================
# Cron Jobs (Vercel)
# ========================================
# Habilitar verificação de fila (true/false)
# CRON_SECRET é fornecida automaticamente pelo Vercel - não é necessário definir localmente
ENABLE_CRON_VERIFICAR_FILA=false

# Intervalo para verificação (minutos). 60 = a cada hora
# Configurar em Vercel: project.json ou CRON_VERIFICAR_FILA_INTERVALO
CRON_VERIFICAR_FILA_INTERVALO=60
